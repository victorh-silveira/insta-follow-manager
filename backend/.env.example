# Gateway mode: "mock" (safe local dev/testing) or "instagrapi" (real Instagram account)
INSTAGRAM_GATEWAY=mock
DATABASE_URL=sqlite:///./insta_manager.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# Only required when INSTAGRAM_GATEWAY=instagrapi
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=./session.json
