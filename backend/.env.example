# Gateway mode: "instagrapi" (real Instagram API) or "mock" (offline demo/testing)
INSTAGRAM_GATEWAY=instagrapi
DATABASE_URL=sqlite:///./data/insta_manager.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# Only required when INSTAGRAM_GATEWAY=instagrapi
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=./data/session.json
