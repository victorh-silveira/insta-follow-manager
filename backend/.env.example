# ---- CONFIGURACAO DA API E GATEWAY ----
# Modo do gateway: "instagrapi" (API real do Instagram) ou "mock" (demo/testes offline)
INSTAGRAM_GATEWAY=instagrapi
DATABASE_URL=sqlite:///./data/insta_manager.db
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- CREDENCIAIS INSTAGRAM (APENAS QUANDO INSTAGRAM_GATEWAY=instagrapi) ----
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=./data/session.json
